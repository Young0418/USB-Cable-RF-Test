# ===== 复制本文件为 .env，并填写真实值 =====
#   Windows:  copy .env.example .env
#   Linux/macOS: cp .env.example .env
#   .env 已被 .gitignore 排除，不会提交到仓库

# ---- DeepSeek AI ----
# 获取方式：https://platform.deepseek.com/ 创建 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 仪器连接 ----
# 是否使用虚拟仪器（无真实硬件调试时保持 1）
#   1 = 连接本地虚拟矢网 (TCPIP0::127.0.0.1::5025::SOCKET)
#   0 = 连接真实仪器，地址由 VISA_ADDRESS 指定
USE_VIRTUAL_VISA=1
# 真实仪器 VISA 地址（USE_VIRTUAL_VISA=0 时生效）
VISA_ADDRESS=TCPIP0::192.168.0.10::5025::SOCKET

# ---- 历史记录 ----
# 历史记录上限（超过丢最旧）
HISTORY_LIMIT=100

# ---- 智能体 ----
# 单轮最大工具调用步数（防死循环）
AGENT_MAX_STEPS=6
# 会话消息数上限（超上限先压缩成摘要再裁剪）
AGENT_SESSION_CAP=40
# 单轮会话累计 token 预算（超预算优雅停止；0 表示不限制）
AGENT_TOKEN_BUDGET=50000
